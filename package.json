{
	"name": "rhubarb",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"predev": "rimraf .next",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"test:ut": "vitest --project unit",
		"test:storybook": "vitest --project storybook",
		"test:all": "vitest",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"supa:start": "supabase start",
		"supa:stop": "supabase stop",
		"supa:reset": "supabase db reset",
		"supa:types": "supabase gen types typescript --local > ./src/backend/types/supabase.ts",
		"supa:migrate": "supabase migration up",
		"testdata:generate": "node ./scripts/generate-test-data.mjs",
		"testdata:import": "node ./scripts/import-test-data.mjs",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@ai-sdk/google": "^3.0.75",
		"@ai-sdk/react": "^3.0.186",
		"@emotion/react": "^11.14.0",
		"@hookform/resolvers": "^5.2.2",
		"@supabase/ssr": "^0.8.0",
		"@supabase/supabase-js": "^2.105.4",
		"ai": "^6.0.184",
		"classnames": "^2.5.1",
		"dayjs": "^1.11.20",
		"material-symbols": "^0.40.2",
		"next": "^16.2.6",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-hook-form": "^7.76.0",
		"react-toastify": "^11.1.0",
		"uuid": "^14.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@storybook/addon-a11y": "^10.4.0",
		"@storybook/addon-docs": "^10.4.0",
		"@storybook/addon-mcp": "^0.2.3",
		"@storybook/addon-vitest": "^10.4.0",
		"@storybook/nextjs-vite": "^10.4.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20.19.41",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/browser-playwright": "^4.1.6",
		"@vitest/coverage-v8": "^4.1.6",
		"babel-plugin-react-compiler": "1.0.0",
		"daisyui": "^5.5.19",
		"eslint": "^9.39.4",
		"eslint-config-next": "16.0.8",
		"eslint-plugin-storybook": "^10.4.0",
		"husky": "^9.1.7",
		"jsdom": "^27.4.0",
		"lint-staged": "^16.4.0",
		"mockdate": "^3.0.5",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"rimraf": "^6.1.3",
		"storybook": "^10.4.0",
		"supabase": "^2.98.2",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.6"
	}
}
